{
  "type": "module",
  "name": "scripter",
  "version": "1.1.2",
  "homepage": "./",
  "main": "main.js",
  "author": "LazarPetrovic1",
  "description": "A simple, light-weight text editor",
  "private": true,
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "codemirror": "^6.0.2",
    "electron-devtools-installer": "^4.0.0",
    "font-list": "^2.1.0",
    "ignore": "^7.0.13",
    "lucide-react": "^1.59.0",
    "minimist": "^1.2.8",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "semver": "^7.8.5",
    "web-vitals": "^2.1.4",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none npm run start:react\" \"wait-on http://127.0.0.1:3000 && cross-env NODE_ENV=development electron .\"",
    "start:react": "react-scripts start",
    "build": "react-scripts build",
    "package": "cross-env INLINE_RUNTIME_CHUNK=false NODE_ENV=production electron-builder",
    "serve": "serve -s build",
    "patch": "node update-version.js --type patch",
    "major": "node update-version.js --type major",
    "minor": "node update-version.js --type minor",
    "prod": "npm run build && npm run package"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "build": {
    "extraMetadata": {
      "main": "main.js"
    },
    "appId": "dev.scripter.editor",
    "productName": "Scripter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      ".env",
      "filesystem.js",
      "icon.png",
      "main.js",
      "package.json",
      "preload.js",
      "settings.js",
      "terminal.js",
      "update-version.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-debug": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}